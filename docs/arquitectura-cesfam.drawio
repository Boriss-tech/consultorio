<mxfile host="app.diagrams.net" agent="claude" version="24.0.0" type="device">
  <diagram id="arq-cesfam-01" name="Arquitectura CESFAM">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Usuarios -->
        <mxCell id="users" value="Usuarios&#10;Director/a · Encargado/a SOME · Coordinador/a de box · Equipo de gestión · Administrador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAEDE6;strokeColor=#0F6B5C;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="540" height="70" as="geometry" />
        </mxCell>

        <!-- Frontend -->
        <mxCell id="frontend" value="FRONTEND&#10;React + Tailwind CSS&#10;(Dashboard: KPIs, gráficos, filtros)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6B5C;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="160" width="300" height="90" as="geometry" />
        </mxCell>

        <!-- Backend -->
        <mxCell id="backend" value="BACKEND&#10;Node.js + Express&#10;(lógica de negocio, autenticación, endpoints por indicador)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6B5C;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="330" width="300" height="100" as="geometry" />
        </mxCell>

        <!-- Base de datos -->
        <mxCell id="db" value="BASE DE DATOS&#10;PostgreSQL / SQLite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6B5C;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="510" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- Dataset simulado -->
        <mxCell id="dataset" value="Dataset simulado (CSV/JSON)&#10;cargado y actualizado por el&#10;Administrador del sistema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E7CE;strokeColor=#8F6420;fontSize=12;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="660" y="510" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Edge: Usuarios -> Frontend -->
        <mxCell id="e1" value="navegador web" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4E5F5A;fontSize=11;endArrow=block;" edge="1" parent="1" source="users" target="frontend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edge: Frontend -> Backend -->
        <mxCell id="e2" value="peticiones HTTP / API REST (JSON)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4E5F5A;fontSize=11;endArrow=block;" edge="1" parent="1" source="frontend" target="backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edge: Backend -> DB -->
        <mxCell id="e3" value="consultas SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4E5F5A;fontSize=11;endArrow=block;" edge="1" parent="1" source="backend" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edge: Dataset -> DB -->
        <mxCell id="e4" value="carga inicial / actualización" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8F6420;fontSize=11;endArrow=block;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="dataset" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
