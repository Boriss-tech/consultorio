# Copia este archivo a ".env" (mismo directorio) y ajusta los valores.
# ".env" NO se sube al repositorio (ver .gitignore) — cada persona que
# clona el proyecto crea el suyo localmente.
#
# Cuentas de prueba del login del prototipo (Sprint 0-2, sin backend aún).
# Cuando exista el backend (Sprint 3), estas variables dejan de usarse y
# el login pasa a validar contra POST /api/auth/login.

VITE_DEMO_ADMIN_USER=admin
VITE_DEMO_ADMIN_PASS=admin
VITE_DEMO_CONSULTA_USER=usuario
VITE_DEMO_CONSULTA_PASS=clave123
